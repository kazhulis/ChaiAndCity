PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Set to true after adding the WooCommerce values below.
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me
WOOCOMMERCE_PAYMENT_METHOD=

# MakeCommerce (Shop ID and Secret key from the Merchant Portal API section).
MAKECOMMERCE_ENABLED=false
MAKECOMMERCE_SHOP_ID=replace_me
MAKECOMMERCE_SECRET_KEY=replace_me
# Set to false for the LIVE environment (default is TEST).
MAKECOMMERCE_TEST=true
# Load carrier rates and pickup points (parcel lockers) from the MakeCommerce Shipping API.
# Requires the one-time sender-address setup in the Shipping Manager (see MakeCommerce docs).
# Shipping provider: makecommerce (default) or swotzy.
SHIPPING_PROVIDER=makecommerce
MAKECOMMERCE_SHIPPING_ENABLED=false
# Optional browser setup token; use at least 32 random characters and remove it after setup.
MAKECOMMERCE_SHIPPING_SETUP_TOKEN=
# Any stable unique string for this installation; never change it once used.
MAKECOMMERCE_SHOP_INSTANCE=chaiandcity-web
# Add only destinations enabled for this shop in MakeCommerce Shipping Manager.
SHIPPING_COUNTRIES=LV
ITEM_WEIGHT_GRAMS=100
# Publicly reachable URL of this API (MakeCommerce calls it back; localhost won't work for notifications).
PUBLIC_API_URL=http://localhost:3001

# Set SHIPPING_PROVIDER=swotzy and enable this after adding valid Swotzy API credentials.
SWOTZY_ENABLED=false
SWOTZY_API_URL=https://api.swotzy.com/public
SWOTZY_API_USER=replace_me
SWOTZY_API_TOKEN=replace_me
SWOTZY_CURRENCY=EUR
# Optional representative destination postcode for Swotzy rate quotes.
# Required when quoting a country different from the sender country.
SWOTZY_RATE_ZIP=
# Carriers offered as parcel locker providers (comma-separated Swotzy carrier codes).
SWOTZY_PARCEL_CARRIERS=OMNIVA,DPD,LATVIJAS_PASTS,VENIPAK,ITELLA
# Optional overrides. By default the sender address and e-mail are read from the WooCommerce store settings; SWOTZY_SENDER_PHONE is needed because WooCommerce has no phone setting.
SWOTZY_SENDER_NAME=Chai and City
SWOTZY_SENDER_PHONE=+37100000000
SWOTZY_SENDER_EMAIL=shop@example.com
SWOTZY_SENDER_ADDRESS=replace_me
SWOTZY_SENDER_ZIP=LV-1000
SWOTZY_SENDER_CITY=Riga
SWOTZY_SENDER_COUNTRY=LV
SWOTZY_PACKAGE_LENGTH_CM=20
SWOTZY_PACKAGE_WIDTH_CM=15
SWOTZY_PACKAGE_HEIGHT_CM=10

# Use the exact secret configured for each WooCommerce webhook.
WOOCOMMERCE_WEBHOOK_SECRET=replace_me
PAYMENT_WEBHOOK_SECRET=replace_me
