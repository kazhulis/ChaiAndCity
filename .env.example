PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Set to true after adding the WooCommerce values below.
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me
WOOCOMMERCE_PAYMENT_METHOD=

# MakeCommerce (Shop ID and Secret key from the Merchant Portal API section).
MAKECOMMERCE_ENABLED=false
MAKECOMMERCE_SHOP_ID=replace_me
MAKECOMMERCE_SECRET_KEY=replace_me
# Set to false for the LIVE environment (default is TEST).
MAKECOMMERCE_TEST=true
# Load carrier rates and pickup points (parcel lockers) from the MakeCommerce Shipping API.
# Requires the one-time sender-address setup in the Shipping Manager (see MakeCommerce docs).
MAKECOMMERCE_SHIPPING_ENABLED=false
# Any stable unique string for this installation; never change it once used.
MAKECOMMERCE_SHOP_INSTANCE=chaiandcity-web
# Add only destinations enabled for this shop in MakeCommerce Shipping Manager.
SHIPPING_COUNTRIES=LV
ITEM_WEIGHT_GRAMS=100
# Publicly reachable URL of this API (MakeCommerce calls it back; localhost won't work for notifications).
PUBLIC_API_URL=http://localhost:3001

# Set to true after adding the Swotzy values below.
SWOTZY_ENABLED=false
SWOTZY_API_URL=https://api.swotzy.example
SWOTZY_API_TOKEN=replace_me

# Use the exact secret configured for each WooCommerce webhook.
WOOCOMMERCE_WEBHOOK_SECRET=replace_me
PAYMENT_WEBHOOK_SECRET=replace_me
